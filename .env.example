# ---- Base de datos PostgreSQL ----
# Local (desarrollo)
DATABASE_URL=postgresql://petrobox:petrobox@localhost:5432/easypos

# Producción (bilbo por Tailscale, puerto 2002)
# DATABASE_URL=postgresql://petrobox:petrobox@localhost:5432/easypos

# Pon PGSSL=true si el servidor exige TLS
# PGSSL=false

# ---- Multi-negocio (central PROPIA de easy pos) ----
# Con esto la app atiende a varios negocios: el registro (negocio, dispositivo,
# usuarios del panel) vive en bo_epos_central (db/central.sql) y cada negocio
# tiene su base bo_epos_<slug>. Sin esta variable: modo de UN solo negocio.
# CENTRAL_DATABASE_URL=postgresql://petrobox:petrobox@localhost:5432/bo_epos_central
# Bases de los negocios en OTRO servidor que la central ({db} = bo_epos_<slug>):
# TENANT_DATABASE_URL_TEMPLATE=postgresql://petrobox:petrobox@localhost:5432/{db}
# Clave para usar /api/provision por script (el panel /panel usa su propio login):
# PROVISION_KEY=genera-una-clave-larga

# ---- Login del panel /panel con Google (solo el equipo @petroboxinc.com) ----
# Con GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET el panel entra ÚNICAMENTE con
# "Ingresar con Google" (cuentas del dominio; se crean solas la primera vez).
# Sin ellas (desarrollo) queda el correo+contraseña contra la central.
# El cliente OAuth es el mismo patrón que case.easypaybo.com; en la consola de
# Google hay que registrar la redirect URI del panel:
#   https://easypos.easypaybo.com/api/panel/auth/google/callback
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# La redirect se arma sola con el host de la request; para forzarla:
# GOOGLE_REDIRECT_URI=https://easypos.easypaybo.com/api/panel/auth/google/callback
# PANEL_ALLOWED_DOMAIN=petroboxinc.com

# Secreto para firmar las sesiones (cookies). Cambiar en producción.
AUTH_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# ---- Integración con COMANDER (dashboard central) ----
# Token compartido para la API de lectura /api/central/*. Generar uno propio.
CENTRAL_API_TOKEN=cmdr_genera-un-token-aleatorio

# ---- Reporte de bugs → Tickets (botón "Debug") ----
# API key del app_client de FloresOnline en tickets.petroboxinc.com (canal
# público /api/public/report). Server-side; los tickets entran en "desarrollo".
TICKETS_API=https://tickets.petroboxinc.com/api
# TICKETS_API_KEY=pbx_...

# ---- Vendedor 24/7 (bot de WhatsApp con IA) ----
# Probar todo local (sin WhatsApp real):
#   POST /api/whatsapp/simulate  { "text": "Hola, quiero un ramo" }

# --- IA (Claude) ---
# Modo 1: token de la CUENTA (suscripción/OAuth). Es lo que se usa hoy: si hay
#   sesión de Claude Code, el bot lee el token de ~/.claude/.credentials.json
#   automáticamente. Para forzarlo/desplegarlo, exportar el access token:
# ANTHROPIC_AUTH_TOKEN=sk-ant-oat01-...
# Modo 2: API key clásica (tiene prioridad si está presente):
# ANTHROPIC_API_KEY=sk-ant-...
# Sin ninguno → respuestas simuladas.

# --- WhatsApp ---
# Transporte ACTUAL: Baileys (número por QR). No necesita variables: se vincula
#   desde Admin → Configuración → Vendedor 24/7 → Conectar WhatsApp.
#   La sesión se guarda en ./.wa-auth (ignorado por git).
# Alternativa: WhatsApp Cloud API oficial (Meta), si algún día se migra:
# META_WA_TOKEN=EAAG...
# META_WA_PHONE_ID=1234567890
# META_WA_VERIFY_TOKEN=floresonline_8a6dd6d27a2607b9
# WA_GRAPH_VERSION=v21.0
