{
  "name": "easypos-pc",
  "productName": "easy pos",
  "version": "1.0.0",
  "description": "easy pos — programa de PC: POS de escritorio sobre la API de easy pos (nube o servidor local).",
  "author": "easy pos",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "bo.coquito.pc",
    "productName": "easy pos",
    "compression": "maximum",
    "electronLanguages": [
      "es",
      "en-US"
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "EasyPos-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "shortcutName": "easy pos"
    }
  }
}
